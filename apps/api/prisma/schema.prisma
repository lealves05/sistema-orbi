generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  RECEPTIONIST
  PROFESSIONAL
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  OTHER
}

enum CashStatus {
  OPEN
  CLOSED
}

model Salon {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  phone         String?
  email         String?
  address       String?
  timezone      String          @default("America/Sao_Paulo")
  accentColor   String          @default("#635bff")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  users         User[]
  professionals Professional[]
  services      Service[]
  clients       Client[]
  appointments  Appointment[]
  cashSessions  CashSession[]
  transactions  Transaction[]
  products      Product[]
}

model User {
  id           String   @id @default(cuid())
  salonId      String
  salon        Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RECEPTIONIST)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([salonId])
}

model Professional {
  id               String        @id @default(cuid())
  salonId          String
  salon            Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name             String
  phone            String?
  email            String?
  specialty        String
  color            String        @default("#635bff")
  commissionRate   Decimal       @db.Decimal(5, 2)
  workDays         Int[]         @default([1, 2, 3, 4, 5, 6])
  startTime        String        @default("09:00")
  endTime          String        @default("19:00")
  active           Boolean       @default(true)
  appointments     Appointment[]
  transactionItems Transaction[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([salonId, active])
}

model Service {
  id               String               @id @default(cuid())
  salonId          String
  salon            Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name             String
  category         String
  durationMinutes  Int
  price            Decimal              @db.Decimal(10, 2)
  commissionRate   Decimal              @db.Decimal(5, 2)
  color            String               @default("#635bff")
  active           Boolean              @default(true)
  appointmentItems AppointmentService[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([salonId, active])
}

model Client {
  id           String        @id @default(cuid())
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  birthDate    DateTime?
  notes        String?
  tags         String[]      @default([])
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([salonId, phone])
  @@index([salonId, name])
}

model Appointment {
  id             String               @id @default(cuid())
  salonId        String
  salon          Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professionalId String
  professional   Professional         @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus    @default(SCHEDULED)
  notes          String?
  total          Decimal              @db.Decimal(10, 2)
  items          AppointmentService[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([salonId, startsAt])
  @@index([professionalId, startsAt, endsAt])
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  price         Decimal     @db.Decimal(10, 2)
  duration      Int

  @@unique([appointmentId, serviceId])
}

model CashSession {
  id            String        @id @default(cuid())
  salonId       String
  salon         Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  openedBy      String
  closedBy      String?
  openingAmount Decimal       @db.Decimal(10, 2)
  closingAmount Decimal?      @db.Decimal(10, 2)
  status        CashStatus    @default(OPEN)
  openedAt      DateTime      @default(now())
  closedAt      DateTime?
  transactions  Transaction[]

  @@index([salonId, status])
}

model Transaction {
  id             String           @id @default(cuid())
  salonId        String
  salon          Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  cashSessionId  String?
  cashSession    CashSession?     @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   Professional?    @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  type           TransactionType
  description    String
  category       String
  amount         Decimal          @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  occurredAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())

  @@index([salonId, occurredAt])
}

model Product {
  id           String          @id @default(cuid())
  salonId      String
  salon        Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name         String
  sku          String
  category     String
  unit         String          @default("un")
  stock        Decimal         @db.Decimal(10, 2)
  minimumStock Decimal         @db.Decimal(10, 2)
  costPrice    Decimal         @db.Decimal(10, 2)
  salePrice    Decimal?        @db.Decimal(10, 2)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([salonId, sku])
  @@index([salonId, active])
}
